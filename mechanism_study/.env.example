# Copy this file to .env in the same folder and fill in ONE provider.
# The runner reads .env; it never prints or logs the key. Do not share .env.

# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Qwen (Alibaba DashScope, OpenAI-compatible mode)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# LLM_API_KEY=

# Doubao (Volcano Engine Ark). LLM_MODEL is your model or endpoint ID from the Ark console.
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=
# LLM_API_KEY=
